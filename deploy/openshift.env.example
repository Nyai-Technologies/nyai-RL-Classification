# RL Classification: ALL the environment variables of the service (for DevOps).
# Fill in the <...> values; everything else is optional and shown with its default (commented out: leave it out to keep the default).
# This file contains NO real secrets; do not put real ones in git.
# One image, two Deployments: the API (default command) and the Pulsar worker (command: python -m app.pulsar_worker).
# The API ignores the PULSAR_* values; the worker needs the REQUIRED ones.

# =================== SECRETS: put these in an OpenShift Secret ===================
OPENAI_API_KEY=<openai api key>
PULSAR_AUTH_TOKEN=<pulsar jwt token>         # only if the Pulsar cluster needs a token; otherwise leave it out

# =================== REQUIRED ===================
OPENAI_MODEL=gpt-5.6-luna                    # exact OpenAI model id; there is no valid default

# =================== REQUIRED for the Pulsar worker only (no names are assumed: use your cluster's) ===================
PULSAR_SERVICE_URL=<pulsar://host:6650  or  pulsar+ssl://host:6651>      # default pulsar://localhost:6650
PULSAR_INPUT_TOPIC=<persistent://tenant/namespace/requests-topic>
PULSAR_RESULT_TOPIC=<persistent://tenant/namespace/results-topic>
PULSAR_SUBSCRIPTION=<subscription name for this worker>

# =================== OPTIONAL: Pulsar worker ===================
# PULSAR_MAX_IN_FLIGHT=4                     # messages one worker classifies at the same time

# =================== OPTIONAL: classification ===================
# MIN_CONFIDENCE=0.80                        # below this a label goes to review (low_confidence)
# OTHER_AUTO_CONFIDENCE=0.95                 # a confident "not in the RL" (OTHER) is final; above 1 = OTHER always goes to review
# FIRST_CHUNKS=3                             # chunks of a file sent to the model on the first try
# RETRY_CHUNKS=6                             # chunks sent on the retry for an unclear file
# MAX_CHARS=6000                             # most characters of a file sent to the model
# CHUNK_CHARS=1200                           # chunk size when the sender gives plain text (not chunks)

# =================== OPTIONAL: concurrency (size against the OpenAI rate limit: the API and the worker share the key) ===================
# WORKERS=4                                  # files of ONE request classified at the same time
# MAX_LLM_CONCURRENCY=16                     # OpenAI calls in flight per process, shared by all requests of that process

# =================== OPTIONAL: the OpenAI call ===================
# LLM_TEMPERATURE=0                          # "none" = do not send it; dropped automatically if the model rejects it
# LLM_TIMEOUT=60                             # seconds per OpenAI call
# LLM_JSON_MODE=1                            # 0 if the model rejects response_format
# MAX_BACKOFF_TRIES=6                        # tries on a 429 (rate limit) before giving up
# TRANSIENT_RETRIES=3                        # retries on timeouts, dropped connections and 5xx
# SYSTEM_PROMPT_FILE=                        # path to a file that replaces the built-in prompt (mount it from a ConfigMap);
#                                            # it must still ask for the same JSON reply

# =================== OPTIONAL: cost figures ===================
# Unset = looked up automatically (needs egress to raw.githubusercontent.com and openrouter.ai; open.er-api.com for the rate).
# Pin them to avoid those lookups. If the lookups fail the service still works: cost shows "n/a" and the rate falls back.
# LLM_PRICE_IN_PER_M=0.20                    # USD per 1M input tokens (check the current OpenAI price for the model)
# LLM_PRICE_OUT_PER_M=1.20                   # USD per 1M output tokens
# USD_INR=auto                               # auto = live rate; or a number, e.g. 96.5
# USD_INR_FALLBACK=88                        # used when the live rate cannot be fetched
# PRICE_URL_LITELLM=https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json
# PRICE_URL_OPENROUTER=https://openrouter.ai/api/v1/models
# FX_URL=https://open.er-api.com/v6/latest/USD

# =================== OPTIONAL: logging (the image already sets json to stdout) ===================
# LOG_LEVEL=INFO                             # DEBUG adds per-call timing and tokens
# LOG_FORMAT=json                            # json (one object per line) or text; the image sets json
# LOG_FILE=none                              # a file path, or none; the image sets none (logs go to stdout)
# COST_LOG_FILE=none                         # a file path, or none; the image sets none
# COST_LOG_TO_STDOUT=1                       # cost lines also on stdout; default: on when LOG_FORMAT=json

# =================== SET IN THE IMAGE (only change them if you must) ===================
# PORT=8080                                  # the port uvicorn listens on (the API Deployment)
# WEB_CONCURRENCY=2                          # uvicorn processes per pod (the API Deployment)
