# RL Classification: environment for the OpenShift deployment (for DevOps).
# Fill in the <...> values. This file contains NO real secrets; do not put real ones in git.
# Same image for both Deployments: the API (default command) and the Pulsar worker
# (command: python -m app.pulsar_worker). The API does not need the PULSAR_* values; the worker does.

# ---------------- SECRETS: put these in an OpenShift Secret ----------------
OPENAI_API_KEY=<openai api key>
# Only if the Pulsar cluster needs a token (otherwise leave it out):
PULSAR_AUTH_TOKEN=<pulsar jwt token>

# ---------------- REQUIRED (ConfigMap) ----------------
# The exact OpenAI model id. Must be set: there is no valid default.
OPENAI_MODEL=gpt-5.6-luna

# ---------------- REQUIRED for the Pulsar worker only (ConfigMap) ----------------
# No names are assumed: use your cluster's.
PULSAR_SERVICE_URL=<pulsar://host:6650  or  pulsar+ssl://host:6651>
PULSAR_INPUT_TOPIC=<persistent://tenant/namespace/requests-topic>
PULSAR_RESULT_TOPIC=<persistent://tenant/namespace/results-topic>
PULSAR_SUBSCRIPTION=<subscription name for this worker>

# ---------------- ALREADY SET INSIDE THE IMAGE (no need to set) ----------------
# PORT=8080
# WEB_CONCURRENCY=2          (uvicorn processes per pod)
# LOG_FORMAT=json            (logs go to stdout as one JSON object per line)
# LOG_FILE=none
# COST_LOG_FILE=none

# ---------------- OPTIONAL (defaults shown; leave out unless you need to change them) ----------------
# MIN_CONFIDENCE=0.80          # below this a label goes to review
# OTHER_AUTO_CONFIDENCE=0.95   # a confident "not in the RL" is final
# WORKERS=4                    # files of one request classified at the same time
# MAX_LLM_CONCURRENCY=16       # OpenAI calls in flight per process: size it against the OpenAI rate limit,
#                              # the API and the worker share the same key
# PULSAR_MAX_IN_FLIGHT=4       # messages a worker classifies at the same time
# LOG_LEVEL=INFO

# To avoid internet lookups for the cost figures (egress to raw.githubusercontent.com, openrouter.ai, open.er-api.com),
# pin them. Without these the service still works; cost would then show "n/a" and the rupee rate 88.
# LLM_PRICE_IN_PER_M=0.20      # USD per 1M input tokens  (check the current OpenAI price for the model)
# LLM_PRICE_OUT_PER_M=1.20     # USD per 1M output tokens
# USD_INR=<rupees per USD>     # e.g. 96.5
