# ---------- LLM ----------
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.6-luna               # exact model id, e.g. gpt-6-luna or gpt-5.6-luna (different prices!)
# LLM_BASE_URL=                # only for non-default OpenAI-compatible endpoints
# LLM_TEMPERATURE=0           # "none" = do not send; auto-dropped if the model rejects it
# LLM_TIMEOUT=60               # seconds per LLM call
# LLM_JSON_MODE=1              # 0 if the model rejects response_format
# MAX_BACKOFF_TRIES=6          # retries on 429 before giving up
# TRANSIENT_RETRIES=3          # retries on timeouts / dropped connections / 5xx from the LLM provider
# SYSTEM_PROMPT_FILE=          # optional file replacing the built-in prompt (must still ask for the same JSON reply)

# ---------- classification ----------
MIN_CONFIDENCE=0.80            # below this -> low_confidence (review)
OTHER_AUTO_CONFIDENCE=0.95     # a confident OTHER is final, no review (above 1 = always review)
FIRST_CHUNKS=3                 # chunks sent on the first try
RETRY_CHUNKS=6                 # chunks sent on the retry for unclear files
MAX_CHARS=6000                 # cap on text sent to the LLM
CHUNK_CHARS=1200               # chunk size when only raw text is available
WORKERS=4                      # files of ONE request classified at the same time (cost unaffected)
MAX_LLM_CONCURRENCY=16         # LLM calls in flight across ALL requests of one process (protects the provider's rate limit)

# ---------- cost ----------
# Price per 1M tokens in USD. Leave both unset = auto-fetch (LiteLLM price table, then OpenRouter).
# Set both to pin them; 0/0 turns cost reporting off.
# LLM_PRICE_IN_PER_M=
# LLM_PRICE_OUT_PER_M=
# PRICE_URL_LITELLM=https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json
# PRICE_URL_OPENROUTER=https://openrouter.ai/api/v1/models
USD_INR=auto                   # auto = live rate; or pin e.g. 96.5
# USD_INR_FALLBACK=88          # used if the live fetch fails
# FX_URL=https://open.er-api.com/v6/latest/USD
COST_LOG_FILE=logs/cost.log     # none in containers

# ---------- logging ----------
LOG_LEVEL=INFO                 # DEBUG adds per-call LLM timing/tokens
LOG_FORMAT=text                # json for containers/OpenShift: one JSON object per line on stdout
COST_LOG_TO_STDOUT=0           # cost lines also on stdout (default: on when LOG_FORMAT=json)
# LOG_FILE=logs/classify.log   # default; LOG_FILE=none turns file logging off (use none in containers)

# ---------- Pulsar (python -m app.pulsar_worker) ----------
PULSAR_SERVICE_URL=pulsar://localhost:6650        # pulsar+ssl://... for TLS
# PULSAR_AUTH_TOKEN=                              # JWT, if the cluster needs one
PULSAR_INPUT_TOPIC=persistent://public/default/rl-classification-requests
PULSAR_RESULT_TOPIC=persistent://public/default/rl-classification-results
PULSAR_SUBSCRIPTION=rl-classification
PULSAR_MAX_IN_FLIGHT=4          # messages classified at the same time per worker
