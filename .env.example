# Copy to .env and fill in. Everything else has a default (see app/config.py).
# LLM provider: openai (default) | bedrock
LLM_PROVIDER=openai
# provider=openai
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.6-luna
# provider=bedrock (Converse API). Credentials: a Bedrock API key (ABSK...) in AWS_BEARER_TOKEN_BEDROCK,
# or the standard AWS chain (IAM role / AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY).
# BEDROCK_MODEL_ID=             # model or inference-profile id enabled in that region, e.g. us.anthropic.claude-...
# BEDROCK_REGION=               # e.g. us-east-1 (falls back to AWS_REGION)
# AWS_BEARER_TOKEN_BEDROCK=
# LLM_MAX_TOKENS=2048           # cap on one reply (Bedrock only)
# LLM_PRICE_IN_PER_M= / LLM_PRICE_OUT_PER_M=   # pin prices if the Bedrock model id is not in the auto price list

# Only for the Pulsar worker (python -m app.pulsar_worker). The topic names and the subscription are required for it.
# PULSAR_SERVICE_URL=           # pulsar://host:6650, or pulsar+ssl://host:6651 (default pulsar://localhost:6650)
# PULSAR_INPUT_TOPIC=           # where the requests arrive
# PULSAR_RESULT_TOPIC=          # where the results are published
# PULSAR_SUBSCRIPTION=          # this worker's subscription name
