# Copy to .env and fill in. Everything else has a default (see app/config.py).
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.6-luna

# Only for the Pulsar worker (python -m app.pulsar_worker). The topic names and the subscription are required for it.
# PULSAR_SERVICE_URL=           # pulsar://host:6650, or pulsar+ssl://host:6651 (default pulsar://localhost:6650)
# PULSAR_INPUT_TOPIC=           # where the requests arrive
# PULSAR_RESULT_TOPIC=          # where the results are published
# PULSAR_SUBSCRIPTION=          # this worker's subscription name

# Only for the Kafka worker (python -m app.kafka_worker). The topics and the consumer group are required for it; every other
# KAFKA_* setting (security, SASL, sizes, compression, offsets, ...) is optional and listed with its default in app/config.py.
# KAFKA_BOOTSTRAP_SERVERS=      # host:9092,host2:9092 (default localhost:9092)
# KAFKA_INPUT_TOPIC=            # where the requests arrive
# KAFKA_OUTPUT_TOPIC=           # where the results are published
# KAFKA_CONSUMER_GROUP=         # pods of one group split the partitions
